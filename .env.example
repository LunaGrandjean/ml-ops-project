# Local development only. Change the passwords before sharing or deploying.
MINIO_ROOT_USER=mlops-dev
MINIO_ROOT_PASSWORD=change-this-local-password
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=trajectory-classification
MODEL_NAME=trajectory-classifier
# Leave empty before the first training: /health/live=200, /health/ready=503.
# After promotion: models:/trajectory-classifier@production
MODEL_URI=
API_URL=http://localhost:8000
MAX_UPLOAD_BYTES=5242880


# Maximum decoded image area, checked before inference.
MAX_IMAGE_PIXELS=4000000
